generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mountain {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  status      String    @default("chiqilmagan")
  rating      Int
  userId      String //Clerk dan keladi
  davlat      String
  location    String?
  balandlik   Int?
  qanchaVaqt  Int?
  dateHiked   DateTime @default(now())
  maslahatBeraman Boolean
  createdAt   DateTime  @default(now())
}
